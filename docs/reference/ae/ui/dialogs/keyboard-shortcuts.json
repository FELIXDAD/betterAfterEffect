{
  "schemaVersion": "1.0",
  "id": "keyboard-shortcuts",
  "title": {
    "zh": "键盘快捷键",
    "en": "Keyboard Shortcuts"
  },
  "triggers": [
    {
      "action": "Keyboard Shortcuts",
      "shortcutWin": "Ctrl+Alt+'",
      "menuZh": "编辑 ▸ 键盘快捷键"
    }
  ],
  "source": {
    "application": "Adobe After Effects 26.0 (26.0x67)",
    "platform": "Windows 11 Pro x64 (3840x2160 @ 150% DPI)",
    "localeObserved": "zh_CN",
    "method": "Live MSAA inspection + interactive tab/radio/dropdown probing + ExtendScript range probing"
  },
  "geometry": {
    "physicalPxAt144Dpi": {
      "w": 2302,
      "h": 1339
    },
    "logicalPxAt96Dpi": {
      "w": 1535,
      "h": 893
    }
  },
  "persistence": {
    "remembersLastValues": true,
    "persistsAcrossRestarts": true,
    "notesZh": "所选快捷键预设与自定义绑定跨重启持久化保存为用户目录 `aeks/` 下的 `.txt` 预设文件；修改内置 `After Effects 默认值.txt` 时自动切换为 `自定义.txt`（或用户另存的新预设）。"
  },
  "buttonBar": {
    "position": "bottom_right",
    "right": [
      {
        "id": "ok",
        "type": "button",
        "zh": "确定",
        "en": "OK",
        "role": "accept"
      },
      {
        "id": "cancel",
        "type": "button",
        "zh": "取消",
        "en": "Cancel",
        "role": "reject"
      }
    ]
  },
  "tabs": [],
  "controls": [
    {
      "id": "preset",
      "type": "dropdown",
      "zh": "预设:",
      "en": "Keyboard Layout Preset:",
      "defaultValue": {
        "zh": "After Effects 默认值.txt",
        "en": "After Effects Default.txt"
      },
      "options": [
        {
          "zh": "After Effects 默认值.txt",
          "en": "After Effects Default.txt"
        },
        {
          "zh": "自定义.txt",
          "en": "Custom.txt"
        }
      ],
      "notesZh": "列出内置只读预设及所有用户自定义 `.txt` 预设文件。"
    },
    {
      "id": "save_as",
      "type": "button",
      "zh": "另存为...",
      "en": "Save As..."
    },
    {
      "id": "delete_preset",
      "type": "button",
      "zh": "删除",
      "en": "Delete",
      "enableRuleZh": "选中内置 `After Effects 默认值.txt` 时置灰禁用；选中自定义/用户预设时可用。"
    },
    {
      "id": "copy_to_clipboard",
      "type": "button",
      "zh": "复制到剪贴板",
      "en": "Copy to Clipboard",
      "notesZh": "将当前预设的完整快捷键表复制为纯文本。"
    },
    {
      "id": "keyboard_layout",
      "type": "dropdown",
      "zh": "键盘布局 -",
      "en": "Keyboard Layout:",
      "defaultValue": {
        "zh": "en",
        "en": "en"
      },
      "options": [
        {
          "zh": "en",
          "en": "en"
        },
        {
          "zh": "pt",
          "en": "pt"
        },
        {
          "zh": "ja",
