        },
        {
          "zh": "it",
          "en": "it"
        },
        {
          "zh": "de",
          "en": "de"
        }
      ],
      "notesZh": "共 11 种物理键盘区域布局代码，仅影响可视化键盘绘制与键帽标签。"
    },
    {
      "id": "command_scope",
      "type": "dropdown",
      "zh": "命令:",
      "en": "Commands:",
      "defaultValue": {
        "zh": "应用程序",
        "en": "Application"
      },
      "options": [
        {
          "zh": "应用程序",
          "en": "Application"
        },
        {
          "zh": "合成面板",
          "en": "Composition Panel"
        },
        {
          "zh": "图层面板",
          "en": "Layer Panel"
        },
        {
          "zh": "字符和段落面板",
          "en": "Character and Paragraph Panels"
        },
        {
          "zh": "应用",
          "en": "App"
        },
        {
          "zh": "效果控件面板",
          "en": "Effect Controls Panel"
        },
        {
          "zh": "时间轴面板",
          "en": "Timeline Panel"
        },
        {
          "zh": "查看器面板",
          "en": "Viewer Panel"
        },
        {
          "zh": "流程图面板",
          "en": "Flowchart Panel"
        },
        {
          "zh": "渲染队列面板",
          "en": "Render Queue Panel"
