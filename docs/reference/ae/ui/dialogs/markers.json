{
  "schemaVersion": "1.0",
  "id": "markers",
  "title": {
    "zh": "合成标记 / 图层标记",
    "en": "Composition Marker / Layer Marker"
  },
  "triggers": [
    {
      "action": "Add & Edit Composition Marker",
      "shortcutWin": "Alt+Numpad *",
      "menuZh": "未选中图层时按 Alt+Numpad *（或双击合成标记）"
    },
    {
      "action": "Add & Edit Layer Marker",
      "shortcutWin": "Alt+Numpad *",
      "menuZh": "选中图层时按 Alt+Numpad *（或双击图层标记）"
    }
  ],
  "source": {
    "application": "Adobe After Effects 26.0 (26.0x67)",
    "platform": "Windows 11 Pro x64 (3840x2160 @ 150% DPI)",
    "localeObserved": "zh_CN",
    "method": "Live MSAA inspection + interactive tab/radio/dropdown probing + ExtendScript range probing"
  },
  "geometry": {
    "physicalPxAt144Dpi": {
      "w": 673,
      "h": 572
    },
    "logicalPxAt96Dpi": {
      "w": 449,
      "h": 381
    },
    "layerMarkerPhysicalPxAt144Dpi": {
      "w": 639,
      "h": 560
    },
    "layerMarkerLogicalPxAt96Dpi": {
      "w": 426,
      "h": 373
    }
  },
  "persistence": {
    "remembersLastValues": false,
    "persistsPerMarker": true,
    "notesZh": "新建标记默认时间为当前播放头、持续时间 0:00:00:00、注释为空、标签为“无”；AE 26 已精简移除旧版章节/Web 链接/Flash 提示点字段。"
  },
  "buttonBar": {
    "position": "bottom_right",
    "right": [
      {
        "id": "ok",
        "type": "button",
        "zh": "确定",
        "en": "OK",
        "role": "accept"
      },
      {
        "id": "cancel",
        "type": "button",
        "zh": "取消",
        "en": "Cancel",
        "role": "reject"
      }
    ]
  },
  "tabs": [
    {
      "id": "composition_marker",
      "zh": "合成标记（标题：合成标记）",
      "en": "Composition Marker",
      "controls": [
        {
          "id": "time",
          "type": "timecode_scrub",
          "zh": "时间:",
          "en": "Time:",
          "defaultValue": "<当前播放头时间>",
          "notesZh": "右侧只读显示解析时间与基准帧率（如“是 0:00:02:00  基础 30”）。"
        },
        {
          "id": "duration",
          "type": "timecode_scrub",
          "zh": "持续时间:",
          "en": "Duration:",
          "defaultValue": "0:00:00:00",
          "notesZh": "非零值会在时间轴上显示带范围条的区间标记。"
        },
        {
          "id": "comment",
          "type": "multiline_text",
          "zh": "注释:",
          "en": "Comment:",
          "defaultValue": ""
        },
        {
          "id": "label",
          "type": "dropdown",
          "zh": "标签:",
          "en": "Label:",
          "defaultValue": {
            "zh": "无",
            "en": "None"
          },
          "options": [
            {
              "zh": "无",
              "en": "None"
            },
            {
              "zh": "红色",
              "en": "Red"
