        {
          "id": "protected_region",
          "type": "checkbox",
          "zh": "受保护区域",
          "en": "Protected Region",
          "defaultValue": false,
          "enableRuleZh": "合成标记独有控件；用于响应设计时间（Responsive Design - Time）锁定时间段不被拉伸。"
        }
      ]
    },
    {
