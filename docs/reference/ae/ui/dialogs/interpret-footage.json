          "en": "Pixel Aspect Ratio:",
          "defaultValue": {
            "zh": "方形像素",
            "en": "Square Pixels",
            "value": 1.0
          },
          "range": {
            "min": 0.01,
            "max": 100.0
          },
          "options": [
            {
