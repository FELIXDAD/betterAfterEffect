          "options": [
            {
              "zh": "16 毫米",
              "en": "16mm"
            },
            {
              "zh": "35 毫米",
              "en": "35mm"
            }
          ]
        },
        {
          "id": "frame_count",
          "type": "dropdown",
          "zh": "帧计数:",
          "en": "Frame Count:",
          "defaultValue": {
            "zh": "时间码转换",
            "en": "Timecode Conversion"
          },
          "options": [
            {
              "zh": "开始位置 0",
