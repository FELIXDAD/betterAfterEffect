{
  "schemaVersion": "1.0",
  "id": "project-settings",
  "title": {
    "zh": "项目设置",
    "en": "Project Settings"
  },
  "triggers": [
    {
      "action": "Project Settings",
      "shortcutWin": "Ctrl+Alt+Shift+K",
      "menuZh": "文件 ▸ 项目设置..."
    }
  ],
  "source": {
    "application": "Adobe After Effects 26.0 (26.0x67)",
    "platform": "Windows 11 Pro x64 (3840x2160 @ 150% DPI)",
    "localeObserved": "zh_CN",
    "method": "Live MSAA inspection + interactive tab/radio/dropdown probing + ExtendScript range probing"
  },
  "geometry": {
    "physicalPxAt144Dpi": {
      "w": 1029,
      "h": 1174
    },
    "logicalPxAt96Dpi": {
      "w": 686,
      "h": 783
    }
  },
  "persistence": {
    "remembersLastValues": false,
    "persistsPerProject": true,
    "notesZh": "各项设置随项目（.aep）保存，不跨新建项目继承上次值；新建空白项目默认 8 bpc、时间码、Adobe 色彩管理（工作空间无）、48.000 kHz、JavaScript。"
  },
  "buttonBar": {
    "position": "bottom_right",
    "right": [
      {
        "id": "ok",
        "type": "button",
        "zh": "确定",
        "en": "OK",
        "role": "accept"
      },
      {
        "id": "cancel",
        "type": "button",
        "zh": "取消",
        "en": "Cancel",
        "role": "reject"
      }
    ]
  },
  "tabs": [
    {
      "id": "video_rendering_and_effects",
      "zh": "视频渲染和效果",
      "en": "Video Rendering and Effects",
      "controls": [
        {
          "id": "renderer",
          "type": "dropdown",
          "zh": "使用范围:",
          "en": "Use:",
          "defaultValue": {
            "zh": "Mercury GPU 加速 (CUDA)",
            "en": "Mercury GPU Acceleration (CUDA)"
          },
          "options": [
            {
              "zh": "Mercury GPU 加速 (CUDA)",
              "en": "Mercury GPU Acceleration (CUDA)"
            },
            {
              "zh": "仅 Mercury 软件",
              "en": "Mercury Software Only"
            }
          ],
          "notesZh": "GPU 选项按硬件/平台动态显示（NVIDIA Windows 为 CUDA，macOS 为 Metal，OpenCL 卡为 OpenCL）。"
        }
      ]
    },
    {
      "id": "time_display_style",
      "zh": "时间显示样式",
      "en": "Time Display Style",
      "controls": [
        {
          "id": "time_display_mode",
          "type": "radio_group",
          "zh": "显示样式",
          "en": "Time Display Mode",
          "defaultValue": {
            "zh": "时间码",
            "en": "Timecode"
          },
          "options": [
            {
              "id": "timecode",
              "zh": "时间码",
              "en": "Timecode"
            },
            {
              "id": "frames",
              "zh": "帧数",
              "en": "Frames"
            }
          ],
          "notesZh": "实测切换“时间码”与“帧数”时，两组子控件均保持可编辑状态，由当前单选决定生效模式。"
        },
        {
          "id": "footage_start_time",
          "type": "dropdown",
          "zh": "素材开始时间:",
          "en": "Footage Start Time:",
          "defaultValue": {
            "zh": "使用媒体源",
            "en": "Use Media Source"
          },
          "options": [
            {
              "zh": "使用媒体源",
              "en": "Use Media Source"
            },
            {
              "zh": "00:00:00:000",
              "en": "00:00:00:000"
