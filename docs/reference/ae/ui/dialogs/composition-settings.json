{
  "schemaVersion": "1.0",
  "id": "composition-settings",
  "title": {
    "zh": "合成设置",
    "en": "Composition Settings"
  },
  "triggers": [
    {
      "action": "New Composition",
      "shortcutWin": "Ctrl+N",
      "menuZh": "合成 ▸ 新建合成..."
    },
    {
      "action": "Edit Composition Settings",
      "shortcutWin": "Ctrl+K",
      "menuZh": "合成 ▸ 合成设置..."
    }
  ],
  "source": {
    "application": "Adobe After Effects 26.0 (26.0x67)",
    "platform": "Windows 11 Pro x64 (3840x2160 @ 150% DPI)",
    "localeObserved": "zh_CN",
    "method": "Live MSAA inspection + interactive ComboBox/tab probing + ExtendScript range probing"
  },
  "geometry": {
    "physicalPxAt144Dpi": {
      "w": 894,
      "h": 812
    },
    "logicalPxAt96Dpi": {
      "w": 596,
      "h": 541
    }
  },
  "persistence": {
    "remembersLastValues": true,
    "persistsAcrossRestarts": true,
    "prefSection": "Composition Pref Section",
    "notesZh": "跨重启持久化记住上次新建合成的尺寸、像素长宽比、锁定长宽比、帧速率、丢帧、分辨率、开始时间码、持续时间、背景颜色、高级选项卡参数及 3D 渲染器选择。"
  },
  "headerControls": [
    {
      "id": "comp_name",
      "type": "text_input",
      "zh": "合成名称:",
      "en": "Composition Name:",
      "defaultValue": {
        "newCompZh": "合成 1",
        "newCompEn": "Comp 1",
        "editComp": "<当前合成名称>"
      },
      "notesZh": "位于页签栏上方、全页签共享；新建合成按 合成 1/2/3... 递增。"
    }
  ],
  "buttonBar": {
    "position": "bottom",
    "left": [
      {
        "id": "preview",
        "type": "checkbox",
        "zh": "预览",
        "en": "Preview",
        "defaultNewComp": false,
        "defaultEditComp": true,
        "enableRuleZh": "新建合成（Ctrl+N）时未勾选且置灰禁用；编辑已有合成（Ctrl+K）时默认勾选且可用，用于实时预览尺寸/背景色等修改。"
      }
    ],
    "right": [
      {
        "id": "ok",
        "type": "button",
        "zh": "确定",
        "en": "OK",
        "role": "accept"
      },
      {
        "id": "cancel",
        "type": "button",
        "zh": "取消",
        "en": "Cancel",
        "role": "reject"
      }
    ]
  },
  "tabs": [
    {
      "id": "basic",
      "zh": "基本",
      "en": "Basic",
      "controls": [
        {
          "id": "preset",
          "type": "dropdown",
          "zh": "预设:",
          "en": "Preset:",
          "defaultValue": "persisted_last_or_custom",
          "optionsRef": "presets",
          "notesZh": "共 26 个可选条目（自定义 + 25 个内置预设，内含 4 条分组分隔线，总菜单项 30 条）；修改宽度/高度/像素长宽比/帧速率偏离预设后自动切为“自定义”。"
        },
        {
          "id": "save_custom_preset",
          "type": "icon_button",
          "zh": "保存自定义预设",
          "en": "Save Custom Preset",
          "enableRuleZh": "始终可用；点击将当前尺寸/PAR/帧速率存为用户预设。"
        },
        {
          "id": "delete_custom_preset",
          "type": "icon_button",
          "zh": "删除自定义预设",
          "en": "Delete Custom Preset",
          "enableRuleZh": "选中“自定义”或任意内置预设时置灰禁用；仅当选中用户自建预设时可用。"
        },
        {
          "id": "width",
          "type": "number_scrub",
          "internalName": "widthNumEdit",
          "zh": "宽度:",
          "en": "Width:",
          "unit": "px",
          "range": {
            "min": 1,
            "max": 30000,
            "uiTypicalMin": 4,
            "step": 1,
            "type": "integer"
          },
          "defaultValue": "persisted"
        },
        {
          "id": "height",
          "type": "number_scrub",
          "internalName": "heightNumEdit",
          "zh": "高度:",
          "en": "Height:",
          "unit": "px",
          "range": {
            "min": 1,
            "max": 30000,
            "uiTypicalMin": 4,
            "step": 1,
            "type": "integer"
          },
          "defaultValue": "persisted"
        },
        {
          "id": "lock_aspect_ratio",
          "type": "checkbox",
          "zh": "锁定长宽比为 <W>:<H> (<ratio>)",
          "en": "Lock Aspect Ratio to <W>:<H> (<ratio>)",
          "defaultValue": false,
          "notesZh": "动态显示当前宽高比（如 16:9 (1.78) 或 4:3 (1.33)）；勾选后改宽度或高度时另一边按比例联动。"
        },
        {
          "id": "pixel_aspect_ratio",
          "type": "dropdown",
          "zh": "像素长宽比:",
          "en": "Pixel Aspect Ratio:",
          "defaultValue": {
            "zh": "方形像素",
            "en": "Square Pixels",
            "value": 1.0
          },
          "range": {
            "min": 0.01,
            "max": 100.0
          },
          "options": [
            {
              "zh": "方形像素",
              "en": "Square Pixels",
              "value": 1.0
            },
            {
              "zh": "D1/DV NTSC (0.91)",
              "en": "D1/DV NTSC (0.91)",
              "value": 0.909091
            },
            {
              "zh": "D1/DV NTSC 宽银幕  (1.21)",
              "en": "D1/DV NTSC Widescreen (1.21)",
              "value": 1.212121
            },
            {
              "zh": "D1/DV PAL (1.09)",
              "en": "D1/DV PAL (1.09)",
              "value": 1.094017
            },
            {
              "zh": "D1/DV PAL 宽银幕  (1.46)",
              "en": "D1/DV PAL Widescreen (1.46)",
              "value": 1.458689
            },
            {
              "zh": "HDV 1080/DVCPRO HD 720 (1.33)",
              "en": "HDV 1080/DVCPRO HD 720 (1.33)",
              "value": 1.333333
            },
            {
              "zh": "DVCPRO HD 1080 (1.5)",
              "en": "DVCPRO HD 1080 (1.5)",
              "value": 1.5
            },
            {
              "zh": "变形 2:1 (2)",
              "en": "Anamorphic 2:1 (2)",
              "value": 2.0
            }
          ]
        },
        {
          "id": "frame_aspect_ratio",
          "type": "static_text",
          "zh": "画面长宽比:",
          "en": "Frame Aspect Ratio:",
          "format": "<W>:<H> (<ratio>)",
          "notesZh": "只读计算值，位于像素长宽比右侧（如 16:9 (1.78)、9:16 (0.56)、457:333 (1.37)）。"
        },
        {
          "id": "frame_rate",
          "type": "text_input_with_dropdown",
          "zh": "帧速率:",
          "en": "Frame Rate:",
          "unitZh": "帧/秒",
          "unitEn": "Frames per Second",
          "range": {
            "min": 1.0,
            "max": 999.0
          },
          "defaultValue": "persisted",
          "quickPickOptions": [
            8,
            12,
            15,
            23.976,
            24,
            25,
            29.97,
            30,
            50,
            59.94,
            60,
            120
          ],
          "notesZh": "左侧为自由输入的帧速率文本框，紧邻右侧为小箭头快捷预设下拉（12 档常用帧率）。"
        },
        {
          "id": "drop_frame",
          "type": "dropdown",
          "zh": "丢帧模式（无独立标签，位于“帧/秒”右侧）",
          "en": "Drop Frame mode (unlabeled, right of Frames per Second)",
          "defaultValue": {
            "zh": "无丢帧",
            "en": "Non-Drop Frame"
          },
          "options": [
            {
              "zh": "丢帧",
              "en": "Drop Frame"
            },
            {
              "zh": "无丢帧",
              "en": "Non-Drop Frame"
            }
          ],
          "enableRuleZh": "仅当帧速率为 29.97 或 59.94 fps 时启用；其他所有帧速率（23.976/24/25/30/50/60/120 等）均置灰禁用并锁定为“无丢帧”。"
        },
        {
          "id": "resolution",
          "type": "dropdown",
          "zh": "分辨率:",
          "en": "Resolution:",
          "defaultValue": {
            "zh": "完整",
            "en": "Full"
          },
          "options": [
            {
              "zh": "完整",
              "en": "Full",
              "factor": [
                1,
                1
              ]
            },
            {
              "zh": "二分之一",
              "en": "Half",
              "factor": [
                2,
                2
              ]
            },
            {
              "zh": "三分之一",
              "en": "Third",
              "factor": [
                3,
                3
              ]
            },
            {
              "zh": "四分之一",
              "en": "Quarter",
              "factor": [
                4,
                4
              ]
            },
            {
              "zh": "自定义...",
              "en": "Custom...",
              "opensSubDialog": "custom-resolution"
            }
          ],
          "summaryFormatZh": "<W> x <H>，<size> MB/KB（每 8bpc 帧）",
          "summaryFormatEn": "<W> x <H>, <size> MB/KB per 8bpc frame"
        },
        {
          "id": "start_timecode",
          "type": "timecode_input",
          "zh": "开始时间码:",
          "en": "Start Timecode:",
          "defaultValue": "0:00:00:00",
          "noteFormatZh": "是 <TC>  基础 <fps>",
          "noteFormatEn": "is <TC>  Base <fps>",
          "notesZh": "右侧提示中文实测在“基础”前有两个半角空格（例如 `是 0:00:00:00  基础 30`）。"
        },
        {
          "id": "duration",
          "type": "timecode_input",
          "zh": "持续时间:",
          "en": "Duration:",
          "defaultValue": "persisted",
          "range": {
            "minSeconds": 0.0,
            "maxSeconds": 10800.0,
            "maxTimecode": "3:00:00:00"
          },
          "noteFormatZh": "是 <TC>  基础 <fps>",
          "noteFormatEn": "is <TC>  Base <fps>"
        },
        {
          "id": "background_color",
          "type": "color_picker_row",
          "zh": "背景颜色:",
          "en": "Background Color:",
          "defaultValue": {
            "hex": "#000000",
            "zh": "黑色",
            "en": "Black"
          },
          "subControls": [
            "color_swatch_button",
            "eyedropper_button",
            "color_name_label"
          ]
        }
      ]
    },
    {
      "id": "advanced",
      "zh": "高级",
      "en": "Advanced",
      "controls": [
        {
          "id": "anchor",
          "type": "anchor_grid_3x3",
          "internalNames": [
            "pic0",
            "pic1",
            "pic2",
            "pic3",
            "pic4",
            "pic5",
            "pic6",
            "pic7",
            "pic8"
          ],
          "zh": "锚点:",
          "en": "Anchor:",
          "defaultValue": "center (pic4)",
          "enableRuleZh": "新建合成（Ctrl+N）时始终置灰禁用；编辑已有合成（Ctrl+K）时仅在修改了宽度或高度后启用，用于决定画布裁切/扩展时的对齐锚点。"
        },
        {
          "id": "preserve_frame_rate",
          "type": "checkbox",
          "zh": "在嵌套时或在渲染队列中，保留帧速率",
          "en": "Preserve frame rate when nested or in render queue",
          "defaultValue": false
        },
        {
          "id": "preserve_resolution",
          "type": "checkbox",
          "zh": "在嵌套时保留分辨率",
          "en": "Preserve resolution when nested",
          "defaultValue": false
        },
        {
          "id": "shutter_angle",
          "type": "number_scrub",
          "internalName": "shutterAngleNumEdit",
          "zh": "快门角度:",
          "en": "Shutter Angle:",
          "unit": "°",
          "defaultValue": 180,
          "range": {
            "min": 0,
            "max": 720,
            "type": "integer"
          }
        },
        {
          "id": "shutter_phase",
          "type": "number_scrub",
          "internalName": "shutterPhaseNumEdit",
          "zh": "快门相位:",
          "en": "Shutter Phase:",
          "unit": "°",
          "defaultValue": 0,
          "range": {
            "min": -360,
            "max": 360,
            "type": "integer"
          },
          "notesZh": "AE 26 实测新合成默认值为 0°（部分早期文档常记为 -90°）。"
        },
        {
          "id": "samples_per_frame",
          "type": "number_scrub",
          "internalName": "threeDsamplesNumEdit",
          "zh": "每帧样本:",
          "en": "Samples Per Frame:",
          "defaultValue": 16,
          "range": {
            "min": 2,
            "max": 64,
            "type": "integer"
          }
        },
        {
          "id": "adaptive_sample_limit",
          "type": "number_scrub",
          "internalName": "max2DsamplesNumEdit",
          "zh": "自适应采样限制:",
          "en": "Adaptive Sample Limit:",
          "defaultValue": 128,
          "range": {
            "min": 64,
            "max": 256,
            "type": "integer"
          },
          "notesZh": "AE 26 实测下限为 64（非 2），上限 256，默认 128。"
        }
      ]
    },
    {
      "id": "3d_renderer",
      "zh": "3D 渲染器",
      "en": "3D Renderer",
      "controls": [
        {
          "id": "renderer",
          "type": "dropdown",
          "zh": "渲染器:",
          "en": "Renderer:",
          "defaultValue": {
            "zh": "经典 3D",
            "en": "Classic 3D",
            "matchName": "ADBE Advanced 3d"
          },
          "options": [
            {
              "zh": "经典 3D",
              "en": "Classic 3D",
              "matchName": "ADBE Advanced 3d",
              "optionsButtonEnabled": true,
              "optionsSubDialog": "classic-3d-options",
              "showsFeatureComparisonLists": false
            },
            {
              "zh": "高级 3D",
              "en": "Advanced 3D",
              "matchName": "ADBE Calder",
              "optionsButtonEnabled": true,
              "optionsSubDialog": "advanced-3d-options",
              "showsFeatureComparisonLists": true
            },
            {
              "zh": "Cinema 4D",
              "en": "Cinema 4D",
              "matchName": "ADBE Ernst",
              "optionsButtonEnabled": true,
              "optionsSubDialog": "cinema-4d-options",
              "showsFeatureComparisonLists": true
            }
          ]
        },
        {
          "id": "options_button",
          "type": "button",
          "zh": "选项...",
          "en": "Options...",
          "enableRuleZh": "AE 26 中三个渲染器（经典 3D、高级 3D、Cinema 4D）下均启用，分别弹出对应的渲染器选项子对话框。"
        },
        {
          "id": "about_button",
          "type": "button",
          "zh": "关于...",
          "en": "About...",
          "enableRuleZh": "三个渲染器下均启用。"
        },
        {
          "id": "feature_comparison",
          "type": "two_column_list",
          "internalNames": [
            "RendererEnabled",
            "RendererDisabled"
          ],
          "zh": "已启用功能 / 已禁用功能",
          "en": "Enabled Features / Disabled Features",
          "visibilityRuleZh": "选中“经典 3D”时隐藏，仅在选中“高级 3D”或“Cinema 4D”时显示左右两栏能力对照表。"
        }
      ]
    }
  ],
