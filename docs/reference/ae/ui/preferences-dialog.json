  "verificationAnswers": {
    "buttonLayout": "右上角纵向一列（非底部一行），自上而下依次为：确定 (OK)、取消 (Cancel)、上一步 (Previous)、下一步 (Next)。上一步/下一步在首页与末页均保持可用并循环切换。",
    "defaultsCheck": {
      "levelsOfUndo": {
        "inDialogUi": false,
        "backendDefault": 99,
        "preferencesKey": {
          "section": "General Section",
          "key": "Levels of Undo v2"
        },
        "note": "AE 26 已将“撤消级别”从首选项对话框 UI 中移除，仅保留后台键值，默认 99。"
      },
      "autoSaveIntervalMinutes": {
        "inDialogUi": true,
        "pageId": "project",
        "default": 5,
        "unitEn": "minutes",
        "preferencesKey": {
          "section": "Auto Save",
          "key": "Auto Save Interval"
        }
      },
      "maxProjectVersions": {
        "inDialogUi": true,
        "pageId": "project",
        "default": 3,
        "preferencesKey": {
          "section": "Auto Save",
          "key": "Auto Save Max Project Vers"
        }
      }
    }
  },
  "legacy19ToAe26Migration": [
    {
      "legacyZh": "常规 (General)",
      "ae26Pages": [
        "startup_repair",
        "project",
        "composition",
        "appearance"
      ],
      "notes": "拆入启动和修复（主屏幕）、项目（保留工作区/Dynamic Link）、合成（图层创建/拆分/插值/蒙版/同步时间/双击行为）、外观（路径点大小/系统拾色器/禁用缩览图/工具提示/引导标记）；撤消级别已移出 UI（后台默认 99）。"
    },
    {
      "legacyZh": "显示 (Display)",
      "ae26Pages": [
        "appearance"
      ],
      "notes": "并入“外观”（运动路径、在信息面板和流程图中显示渲染进度、硬件加速面板、时间轴同时显示时间码和帧）。"
    },
    {
      "legacyZh": "导入 (Import)",
      "ae26Pages": [
        "import"
      ],
      "notes": "保留为第 9 页“导入”，合并硬件加速解码与自动重新加载素材。"
    },
    {
      "legacyZh": "输出 (Output)",
      "ae26Pages": [
        "export",
        "audio"
      ],
      "notes": "主体改名为第 10 页“导出”；其中的“音频块持续时间”迁至第 11 页“音频”的“导出”分组。"
    },
    {
      "legacyZh": "网格和参考线 (Grids & Guides)",
      "ae26Pages": [
        "grids_guides"
      ],
      "notes": "保留为第 6 页，新增“透明度设置”网格大小/颜色分组。"
    },
    {
      "legacyZh": "标签 (Labels)",
      "ae26Pages": [
        "labels"
      ],
      "notes": "保留为第 7 页，含 3D 模型、其他 3D 及标记（注释/片段）默认标签。"
    },
    {
      "legacyZh": "媒体和磁盘缓存 (Media & Disk Cache)",
      "ae26Pages": [
        "disk"
      ],
      "notes": "改名为第 12 页“磁盘”，新增从磁盘缓存预览与无损压缩帧选项。"
    },
    {
      "legacyZh": "视频预览 (Video Preview)",
      "ae26Pages": [
        "video"
      ],
      "notes": "改名为第 14 页“视频”，新增 HDR/扩展显示范围预览开关。"
    },
    {
      "legacyZh": "外观 (Appearance)",
      "ae26Pages": [
        "appearance"
      ],
      "notes": "保留为第 5 页，旧版亮度滑块改为 3 卡片“颜色主题”（最暗/深色/灯光）+ 无障碍色彩对比度，并吸纳原“显示”页与部分“常规”页选项。"
    },
    {
      "legacyZh": "新建项目 (New Project)",
      "ae26Pages": [
        "project"
      ],
      "notes": "并入第 2 页“项目”（New Project 与 Solids Folder 分组）。"
    },
    {
      "legacyZh": "自动保存 (Auto-Save)",
      "ae26Pages": [
        "project"
      ],
      "notes": "并入第 2 页“项目”（自动保存与自动保存位置分组，默认 5 分钟 / 3 个版本）。"
    },
    {
      "legacyZh": "内存和性能 (Memory & Performance)",
      "ae26Pages": [
        "memory_cpu"
      ],
      "notes": "改名为第 13 页“内存和 CPU”，并吸纳“GPU 信息...”按钮（原在预览页）。"
    },
    {
      "legacyZh": "音频硬件 (Audio Hardware)",
      "ae26Pages": [
        "audio"
      ],
      "notes": "并入第 11 页“音频”（音频硬件分组）。"
    },
    {
      "legacyZh": "音频输出映射 (Audio Output Mapping)",
      "ae26Pages": [
        "audio"
      ],
      "notes": "并入第 11 页“音频”（输出渠道映射分组）。"
    },
    {
      "legacyZh": "同步设置 (Sync Settings)",
      "ae26Pages": [],
      "notes": "AE 26 已移除此页。"
    },
    {
      "legacyZh": "类型 (Type)",
      "ae26Pages": [
        "type"
      ],
      "notes": "保留为第 8 页（字体菜单预览大小、近期字体数量、缺失字体提醒开关；旧版文本引擎单选已移除）。"
    },
    {
      "legacyZh": "3D",
      "ae26Pages": [
        "3d"
      ],
      "notes": "保留为第 15 页（摄像机导航、推拉镜头、3D 缓存）。"
    },
    {
      "legacyZh": "脚本和表达式 (Scripting & Expressions)",
      "ae26Pages": [
        "scripting_expressions"
      ],
      "notes": "保留为第 16 页。"
    },
    {
      "legacyZh": "通知 (Notifications)",
      "ae26Pages": [
        "export"
      ],
      "notes": "并入第 10 页“导出”（渲染通知分组）。"
    },
    {
      "legacyZh": "启动和修复 (Startup & Repair)",
      "ae26Pages": [
        "startup_repair"
      ],
      "notes": "提升为第 1 页（默认打开页，Ctrl+Alt+;）。"
    }
