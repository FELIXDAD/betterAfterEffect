{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bae.invalid/schema/ae-anim-samples-0.1.json",
  "title": "AE keyframe/expression reference data for bae-anim (draft 0.1)",
  "description": "Two documents: bae-anim-cases (input, generated by bridges/ae/samples/gen_anim_cases.py) and bae-anim-samples (output of bridges/ae/bae-anim-samples.jsx run in After Effects). See docs/interop/ae-anim-samples.md.",
  "oneOf": [
    {"$ref": "#/$defs/CasesFile"},
    {"$ref": "#/$defs/SamplesFile"}
  ],
  "$defs": {
    "Flicks": {"type": "integer"},
    "MatchNamePath": {
      "description": "AE matchNames from the layer down to the property.",
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "AttrSpec": {"$ref": "https://bae.invalid/schema/bae-interchange-0.1.json#/$defs/AttrSpec"},
    "FrameRate": {
      "oneOf": [
        {"type": "number", "exclusiveMinimum": 0},
        {
          "type": "object",
          "required": ["num", "den"],
          "properties": {
            "num": {"type": "integer", "minimum": 1},
            "den": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "CompSpec": {
      "type": "object",
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frame_rate": {"$ref": "#/$defs/FrameRate"},
        "duration": {"$ref": "#/$defs/Flicks"}
      },
      "additionalProperties": false
    },
    "LayerSpec": {
      "type": "object",
      "properties": {
        "type": {"enum": ["null", "solid", "shape"]},
        "three_d": {"type": "boolean"},
        "start_time": {"$ref": "#/$defs/Flicks"},
        "stretch": {"type": "number"},
        "separate_position": {"type": "boolean"},
        "effects": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "SampleSpec": {
      "type": "object",
      "properties": {
        "from": {"$ref": "#/$defs/Flicks"},
        "to": {"$ref": "#/$defs/Flicks"},
        "per_frame": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "Case": {
      "type": "object",
      "required": ["id", "group", "property", "attr"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "group": {"type": "string"},
        "description": {"type": "string"},
        "property": {"$ref": "#/$defs/MatchNamePath"},
        "attr": {"$ref": "#/$defs/AttrSpec"},
        "layer": {"$ref": "#/$defs/LayerSpec"},
        "comp": {"$ref": "#/$defs/CompSpec"},
        "sample": {"$ref": "#/$defs/SampleSpec"},
        "other": {
          "description": "Other properties of the same layer to set first (e.g. a Position read by an expression).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["property", "attr"],
            "properties": {
              "property": {"$ref": "#/$defs/MatchNamePath"},
              "attr": {"$ref": "#/$defs/AttrSpec"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "CasesFile": {
      "type": "object",
      "required": ["format", "format_version", "defaults", "cases"],
      "properties": {
        "format": {"const": "bae-anim-cases"},
        "format_version": {"type": "string"},
        "description": {"type": "string"},
        "defaults": {
          "type": "object",
          "required": ["comp", "layer", "sample"],
          "properties": {
            "comp": {"$ref": "#/$defs/CompSpec"},
            "layer": {"$ref": "#/$defs/LayerSpec"},
            "sample": {"$ref": "#/$defs/SampleSpec"}
          },
          "additionalProperties": false
        },
        "cases": {"type": "array", "items": {"$ref": "#/$defs/Case"}}
      },
      "additionalProperties": false
    },
    "Sample": {
      "description": "One evaluated value: all components as numbers (a 1-D value is a one-element array). null = AE returned NaN/Infinity.",
      "type": "array",
      "items": {"type": ["number", "null"]},
      "minItems": 1,
      "maxItems": 4
    },
    "Result": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "error": {"type": "string"},
        "comp": {
          "type": "object",
          "properties": {
            "width": {"type": "integer"},
            "height": {"type": "integer"},
            "frame_rate": {"type": "number"},
            "duration": {"$ref": "#/$defs/Flicks"}
          },
          "additionalProperties": false
        },
        "layer": {
          "type": "object",
          "properties": {
            "start_time": {"$ref": "#/$defs/Flicks"},
            "stretch": {"type": "number"},
            "in_point": {"$ref": "#/$defs/Flicks"},
            "out_point": {"$ref": "#/$defs/Flicks"},
            "three_d": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "property": {
          "type": "object",
          "properties": {
            "path": {"$ref": "#/$defs/MatchNamePath"},
            "value_type": {"enum": ["float", "vec2", "vec3", "color", "unsupported"]},
            "spatial": {"type": "boolean"},
            "dimensions": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "attr": {"$ref": "#/$defs/AttrSpec"},
        "times": {"type": "array", "items": {"$ref": "#/$defs/Flicks"}},
        "pre_expression": {"type": "array", "items": {"$ref": "#/$defs/Sample"}},
        "post_expression": {"type": "array", "items": {"$ref": "#/$defs/Sample"}},
        "expression_error": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "SamplesFile": {
      "type": "object",
      "required": ["format", "format_version", "generator", "time", "results"],
      "properties": {
        "format": {"const": "bae-anim-samples"},
        "format_version": {"type": "string"},
        "generator": {"type": "object"},
        "host": {"type": "object"},
        "exported_at": {"type": "string"},
        "cases_format_version": {"type": "string"},
        "time": {
          "type": "object",
          "required": ["unit", "flicks_per_second", "key_time_base"],
          "properties": {
            "unit": {"const": "flicks"},
            "flicks_per_second": {"const": 705600000},
            "key_time_base": {"enum": ["comp", "layer"]}
          }
        },
        "results": {"type": "array", "items": {"$ref": "#/$defs/Result"}}
      },
      "additionalProperties": false
    }
  }
}
